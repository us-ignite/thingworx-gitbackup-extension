{
  "elementName": "git-delete",
  "name": "Git Delete Repository",
  "description": "Delete a Git repository Thing",
  "category": ["GitBackup"],
  "flags": { "supportsAutoResize": true },
  "properties": {
    "GitThing": { "baseType": "THINGNAME", "isBindingTarget": true, "description": "Git repository Thing" },
    "ThingName": { "baseType": "STRING", "isBindingTarget": true, "description": "Display name for the thing being deleted" }
  },
  "events": {
    "Deleted": { "src": "deleted", "description": "Fired after deletion" },
    "Cancel": { "src": "cancel", "description": "Fired when user cancels" }
  }
}
